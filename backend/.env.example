ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget_coach

ANTHROPIC_API_KEY=your_key_here

PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# ----- AWS Cognito (Google federation) -----
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXX
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=

# OAuth redirects
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:3000

# Sign the short-lived state/PKCE cookies (override in production)
AUTH_STATE_SECRET=change-me-for-prod
